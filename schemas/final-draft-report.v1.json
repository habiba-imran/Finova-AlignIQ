{
  "$defs": {
    "AdapterInfo": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "verified": {
          "const": false,
          "default": false,
          "title": "Verified",
          "type": "boolean"
        },
        "verified_source_versions": {
          "items": {
            "type": "string"
          },
          "title": "Verified Source Versions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "AdapterInfo",
      "type": "object"
    },
    "AxisCoverage": {
      "additionalProperties": false,
      "description": "Declared positions only; no expected clinical axes are invented.",
      "properties": {
        "expected_axes": {
          "default": null,
          "title": "Expected Axes",
          "type": "null"
        },
        "declared_measurements": {
          "default": 0,
          "title": "Declared Measurements",
          "type": "integer"
        },
        "numeric_present": {
          "default": 0,
          "title": "Numeric Present",
          "type": "integer"
        },
        "explicit_zero": {
          "default": 0,
          "title": "Explicit Zero",
          "type": "integer"
        },
        "missing": {
          "default": 0,
          "title": "Missing",
          "type": "integer"
        },
        "invalid": {
          "default": 0,
          "title": "Invalid",
          "type": "integer"
        },
        "ambiguous": {
          "default": 0,
          "title": "Ambiguous",
          "type": "integer"
        },
        "unsupported": {
          "default": 0,
          "title": "Unsupported",
          "type": "integer"
        },
        "unverified": {
          "default": 0,
          "title": "Unverified",
          "type": "integer"
        }
      },
      "title": "AxisCoverage",
      "type": "object"
    },
    "DraftReview": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "engine_version": {
          "default": "0.5.0",
          "enum": [
            "0.2.0",
            "0.5.0"
          ],
          "title": "Engine Version",
          "type": "string"
        },
        "rule_set_version": {
          "default": "2.0.0-phase5",
          "enum": [
            "2.0.0-phase2a",
            "2.0.0-phase5"
          ],
          "title": "Rule Set Version",
          "type": "string"
        },
        "report_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Report Id",
          "type": "string"
        },
        "review_status": {
          "const": "DRAFT",
          "default": "DRAFT",
          "title": "Review Status",
          "type": "string"
        },
        "intended_for": {
          "const": "CLINICIAN_REVIEW",
          "default": "CLINICIAN_REVIEW",
          "title": "Intended For",
          "type": "string"
        },
        "notice": {
          "const": "Prototype — not for clinical use. DRAFT for clinician review. Descriptions concern programmed values, never achieved movement.",
          "default": "Prototype — not for clinical use. DRAFT for clinician review. Descriptions concern programmed values, never achieved movement.",
          "title": "Notice",
          "type": "string"
        },
        "evidence_domain": {
          "enum": [
            "UNVERIFIED",
            "AUTHORIZED_VENDOR",
            "TEST_ONLY"
          ],
          "title": "Evidence Domain",
          "type": "string"
        },
        "clinical_analysis_enabled": {
          "const": false,
          "default": false,
          "title": "Clinical Analysis Enabled",
          "type": "boolean"
        },
        "raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "parser_version": {
          "title": "Parser Version",
          "type": "string"
        },
        "normalization_version": {
          "title": "Normalization Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceInfo"
        },
        "coverage": {
          "$ref": "#/$defs/ReviewCoverage"
        },
        "requested_assessments": {
          "items": {
            "enum": [
              "SUITABILITY",
              "PERIODONTAL",
              "ROOT_BONE",
              "OCCLUSION",
              "IPR",
              "EXTRACTION_SURGERY",
              "PROGNOSIS",
              "ATTACHMENTS",
              "COLLISIONS",
              "COMPLEX_INTERVENTION"
            ],
            "type": "string"
          },
          "title": "Requested Assessments",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "evaluations": {
          "items": {
            "$ref": "#/$defs/RuleEvaluation"
          },
          "title": "Evaluations",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "report_id",
        "evidence_domain",
        "raw_sha256",
        "parser_version",
        "normalization_version",
        "source",
        "coverage",
        "requested_assessments",
        "findings",
        "evaluations",
        "limitations"
      ],
      "title": "DraftReview",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "fixture_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Fixture Id",
          "type": "string"
        },
        "release_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Release Digest",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "expected_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Sha256",
          "type": "string"
        },
        "source_evidence_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Evidence Sha256"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "fixture_id",
        "release_digest",
        "raw_sha256",
        "expected_sha256",
        "source_evidence_sha256",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Rule Version",
          "type": "string"
        },
        "triggering_rules": {
          "items": {
            "$ref": "#/$defs/RuleRef"
          },
          "title": "Triggering Rules",
          "type": "array"
        },
        "tooth_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tooth Id"
        },
        "status": {
          "enum": [
            "OBSERVED",
            "SEMANTICS_UNKNOWN",
            "CONTEXT_REQUIRED",
            "DISABLED",
            "SUPPRESSED",
            "NOT_APPLICABLE",
            "PARSE_INVALID"
          ],
          "title": "Status",
          "type": "string"
        },
        "applicable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Applicable"
        },
        "evaluated": {
          "title": "Evaluated",
          "type": "boolean"
        },
        "finding_type": {
          "enum": [
            "TECHNICAL",
            "DESCRIPTIVE",
            "SAFETY",
            "UNAVAILABLE",
            "OUTPUT"
          ],
          "title": "Finding Type",
          "type": "string"
        },
        "template_id": {
          "title": "Template Id",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "observed_measurements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObservedMeasurement"
          },
          "title": "Observed Measurements",
          "type": "array"
        },
        "missing_required_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing Required Fields",
          "type": "array"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "abstain_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abstain Reason"
        },
        "review_status": {
          "const": "DRAFT",
          "default": "DRAFT",
          "title": "Review Status",
          "type": "string"
        },
        "conflict_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conflict Group"
        },
        "summary_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Summary Counts",
          "type": "object"
        },
        "predicate_result": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate Result"
        },
        "approval_status": {
          "default": "NOT APPLICABLE",
          "enum": [
            "NOT APPROVED",
            "NOT APPLICABLE"
          ],
          "title": "Approval Status",
          "type": "string"
        },
        "policy_id": {
          "default": null,
          "title": "Policy Id",
          "type": "null"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "rule_id",
        "triggering_rules",
        "status",
        "applicable",
        "evaluated",
        "finding_type",
        "template_id",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "GenerationInfo": {
      "additionalProperties": false,
      "properties": {
        "requested_mode": {
          "enum": [
            "AUTO",
            "GROQ",
            "TEMPLATES"
          ],
          "title": "Requested Mode",
          "type": "string"
        },
        "used_mode": {
          "enum": [
            "STANDARD_TEMPLATES",
            "GROQ_AI",
            "MIXED"
          ],
          "title": "Used Mode",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "const": "GROQ",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "model": {
          "anyOf": [
            {
              "const": "openai/gpt-oss-120b",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "attempts": {
          "maximum": 2,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "eligible_wording_findings": {
          "minimum": 0,
          "title": "Eligible Wording Findings",
          "type": "integer"
        },
        "accepted_comments": {
          "minimum": 0,
          "title": "Accepted Comments",
          "type": "integer"
        },
        "real_patient_transmission_enabled": {
          "const": false,
          "default": false,
          "title": "Real Patient Transmission Enabled",
          "type": "boolean"
        },
        "output_validation": {
          "const": "CLOSED_WORDING_AND_LOCAL_FACTS_V1",
          "default": "CLOSED_WORDING_AND_LOCAL_FACTS_V1",
          "title": "Output Validation",
          "type": "string"
        }
      },
      "required": [
        "requested_mode",
        "used_mode",
        "reason",
        "attempts",
        "eligible_wording_findings",
        "accepted_comments"
      ],
      "title": "GenerationInfo",
      "type": "object"
    },
    "ObservedMeasurement": {
      "additionalProperties": false,
      "properties": {
        "measurement_id": {
          "title": "Measurement Id",
          "type": "string"
        },
        "tooth_ref": {
          "title": "Tooth Ref",
          "type": "string"
        },
        "raw_tooth_identifier": {
          "title": "Raw Tooth Identifier",
          "type": "string"
        },
        "raw_label": {
          "title": "Raw Label",
          "type": "string"
        },
        "raw_value": {
          "title": "Raw Value",
          "type": "string"
        },
        "raw_number": {
          "title": "Raw Number",
          "type": "string"
        },
        "raw_sign": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Sign"
        },
        "raw_direction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Direction"
        },
        "signed_decimal": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Signed Decimal",
          "type": "string"
        },
        "magnitude": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Magnitude",
          "type": "string"
        },
        "verification": {
          "enum": [
            "VERIFIED",
            "TEST_ONLY"
          ],
          "title": "Verification",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/SemanticComponent"
          },
          "title": "Components",
          "type": "array"
        },
        "input_refs": {
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "source_spans": {
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "title": "Source Spans",
          "type": "array"
        },
        "tooth_group": {
          "anyOf": [
            {
              "enum": [
                "INCISOR",
                "CANINE",
                "PREMOLAR",
                "MOLAR",
                "PRIMARY",
                "SUPERNUMERARY",
                "NON_TOOTH"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tooth Group"
        },
        "additional_evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Additional Evidence Refs",
          "type": "array"
        },
        "pair_evidence_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pair Evidence Ref"
        }
      },
      "required": [
        "measurement_id",
        "tooth_ref",
        "raw_tooth_identifier",
        "raw_label",
        "raw_value",
        "raw_number",
        "raw_sign",
        "raw_direction",
        "signed_decimal",
        "magnitude",
        "verification",
        "components",
        "input_refs",
        "source_spans"
      ],
      "title": "ObservedMeasurement",
      "type": "object"
    },
    "RawCell": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "title": "Raw",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        }
      },
      "required": [
        "raw",
        "span"
      ],
      "title": "RawCell",
      "type": "object"
    },
    "ReportComment": {
      "additionalProperties": false,
      "properties": {
        "comment_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Comment Id",
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/RuleRef"
          },
          "title": "Rules",
          "type": "array"
        },
        "section": {
          "enum": [
            "TOOTH",
            "SUMMARY",
            "UNAVAILABLE"
          ],
          "title": "Section",
          "type": "string"
        },
        "tooth_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tooth Id"
        },
        "evidence_status": {
          "enum": [
            "VERIFIED",
            "TEST_ONLY",
            "UNVERIFIED"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
