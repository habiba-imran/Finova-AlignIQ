            "NOT_REQUESTED",
            "ACCEPTED",
            "FALLBACK"
          ],
          "title": "Wording Validation",
          "type": "string"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Reason"
        },
        "measurements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObservedMeasurement"
          },
          "title": "Measurements",
          "type": "array"
        },
        "input_refs": {
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "missing_required_fields": {
          "items": {
            "type": "string"
          },
          "title": "Missing Required Fields",
          "type": "array"
        },
        "abstain_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Abstain Reasons",
          "type": "array"
        },
        "evaluation_statuses": {
          "items": {
            "type": "string"
          },
          "title": "Evaluation Statuses",
          "type": "array"
        }
      },
      "required": [
        "comment_id",
        "finding_ids",
        "rules",
        "section",
        "evidence_status",
        "text",
        "input_refs",
        "evidence_refs",
        "missing_required_fields",
        "abstain_reasons",
        "evaluation_statuses"
      ],
      "title": "ReportComment",
      "type": "object"
    },
    "ReviewCoverage": {
      "additionalProperties": false,
      "properties": {
        "declared_positions": {
          "title": "Declared Positions",
          "type": "integer"
        },
        "eligible_positions": {
          "title": "Eligible Positions",
          "type": "integer"
        },
        "unavailable_positions": {
          "title": "Unavailable Positions",
          "type": "integer"
        },
        "eligible_explicit_zero": {
          "title": "Eligible Explicit Zero",
          "type": "integer"
        },
        "eligible_nonzero": {
          "title": "Eligible Nonzero",
          "type": "integer"
        },
        "expected_axes": {
          "default": null,
          "title": "Expected Axes",
          "type": "null"
        },
        "lexical": {
          "$ref": "#/$defs/AxisCoverage"
