{
  "$defs": {
    "AnchorageNote": {
      "additionalProperties": false,
      "properties": {
        "tooth_ref": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tooth Ref"
        },
        "note": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "note"
      ],
      "title": "AnchorageNote",
      "type": "object"
    },
    "AttachmentDetail": {
      "additionalProperties": false,
      "properties": {
        "tooth_ref": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Tooth Ref",
          "type": "string"
        },
        "choice": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "ATTACHMENT",
            "NO_ATTACHMENT"
          ],
          "title": "Choice",
          "type": "string"
        },
        "design": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Design"
        },
        "width_mm": {
          "anyOf": [
            {
              "maxLength": 24,
              "pattern": "^\\+?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width Mm"
        },
        "height_mm": {
          "anyOf": [
            {
              "maxLength": 24,
              "pattern": "^\\+?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height Mm"
        },
        "depth_mm": {
          "anyOf": [
            {
              "maxLength": 24,
              "pattern": "^\\+?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth Mm"
        },
        "surface": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Surface"
        },
        "orientation": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orientation"
        }
      },
      "required": [
        "tooth_ref"
      ],
      "title": "AttachmentDetail",
      "type": "object"
    },
    "AttachmentOption": {
      "additionalProperties": false,
      "properties": {
        "concept": {
          "enum": [
            "RECTANGULAR",
            "VERTICAL_RECTANGULAR",
            "HORIZONTAL_RECTANGULAR",
            "OVAL",
            "OPTIMIZED_STYLE",
            "NO_ATTACHMENT"
          ],
          "title": "Concept",
          "type": "string"
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Geometry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "orientation": {
          "anyOf": [
            {
              "enum": [
                "VERTICAL",
                "HORIZONTAL",
                "UNSPECIFIED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orientation"
        },
        "surface": {
          "anyOf": [
            {
              "enum": [
                "BUCCAL",
                "LINGUAL"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Surface"
        },
        "placement": {
          "anyOf": [
            {
              "$ref": "#/$defs/Placement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "concept"
      ],
      "title": "AttachmentOption",
      "type": "object"
    },
    "FunctionalContext": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9_-]{1,60}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Id"
        },
        "policy_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Policy Version",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "module": {
          "enum": [
            "macro",
            "micro",
            "nano"
          ],
          "title": "Module",
          "type": "string"
        },
        "origin": {
          "default": "EXPLICIT_SYNTHETIC_SCENARIO",
          "enum": [
            "EXPLICIT_SYNTHETIC_SCENARIO",
            "INPUT_DRIVEN_POLICY_REVIEW"
          ],
          "title": "Origin",
          "type": "string"
        },
        "notation": {
          "default": "UNVERIFIED",
          "enum": [
            "FDI",
            "UNVERIFIED"
          ],
          "title": "Notation",
          "type": "string"
        },
        "objectives": {
          "items": {
            "enum": [
              "REDISTRIBUTE_TRANSLATIONS",
              "ANGULAR_CONTROL",
              "VERTICAL_REVIEW",
              "STAGE_REVIEW"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Objectives",
          "type": "array"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/MovementTarget"
          },
          "maxItems": 64,
          "title": "Targets",
          "type": "array"
        },
        "attachment_options": {
          "items": {
            "$ref": "#/$defs/AttachmentOption"
          },
          "maxItems": 6,
          "title": "Attachment Options",
          "type": "array"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/Phase"
          },
          "maxItems": 16,
          "title": "Phases",
          "type": "array"
        },
        "stage_value_basis": {
          "default": "UNSPECIFIED",
          "enum": [
            "UNSPECIFIED",
            "INCREMENTS_MATCH_SOURCE_LABELS"
          ],
          "title": "Stage Value Basis",
          "type": "string"
        },
        "support_constraints": {
          "items": {
            "$ref": "#/$defs/SupportConstraint"
          },
          "maxItems": 16,
          "title": "Support Constraints",
          "type": "array"
        }
      },
      "required": [
        "source_sha256",
        "module"
      ],
      "title": "FunctionalContext",
      "type": "object"
    },
    "Geometry": {
      "additionalProperties": false,
      "properties": {
        "width_mm": {
          "maxLength": 24,
          "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
          "title": "Width Mm",
          "type": "string"
        },
        "height_mm": {
          "maxLength": 24,
          "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
          "title": "Height Mm",
          "type": "string"
        },
        "depth_mm": {
          "maxLength": 24,
          "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
          "title": "Depth Mm",
          "type": "string"
        }
      },
      "required": [
        "width_mm",
        "height_mm",
        "depth_mm"
      ],
      "title": "Geometry",
      "type": "object"
    },
    "MovementTarget": {
      "additionalProperties": false,
      "properties": {
        "measurement_ref": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Measurement Ref",
          "type": "string"
        },
        "amount": {
          "maxLength": 24,
          "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
          "title": "Amount",
          "type": "string"
        },
        "unit": {
          "enum": [
            "mm",
            "deg"
          ],
          "title": "Unit",
          "type": "string"
        },
        "source_direction": {
          "anyOf": [
            {
              "maxLength": 4,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Direction"
        }
      },
      "required": [
        "measurement_ref",
        "amount",
        "unit"
      ],
      "title": "MovementTarget",
      "type": "object"
    },
    "Phase": {
      "additionalProperties": false,
      "properties": {
        "phase_id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Phase Id",
          "type": "string"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "stage_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Stage Ids",
          "type": "array"
        }
      },
      "required": [
        "phase_id",
        "label",
        "stage_ids"
      ],
      "title": "Phase",
      "type": "object"
    },
    "Placement": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "const": "FICTIONAL_TOOTH_LOCAL_MM",
          "title": "Frame",
          "type": "string"
        },
        "x_mm": {
          "maxLength": 24,
          "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
          "title": "X Mm",
          "type": "string"
        },
        "y_mm": {
          "maxLength": 24,
          "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
          "title": "Y Mm",
          "type": "string"
        },
        "z_mm": {
          "maxLength": 24,
          "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
          "title": "Z Mm",
          "type": "string"
        }
      },
      "required": [
        "frame",
        "x_mm",
        "y_mm",
        "z_mm"
      ],
      "title": "Placement",
      "type": "object"
    },
    "PlanningOptions": {
      "additionalProperties": false,
      "description": "Reusable review settings; never a fixture identifier or clinical approval.",
      "properties": {
        "policy_mode": {
          "default": "SYNTHETIC_REVIEW",
          "enum": [
            "SYNTHETIC_REVIEW",
            "EVIDENCE_REVIEW"
          ],
          "title": "Policy Mode",
          "type": "string"
        },
        "source_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "objectives": {
          "items": {
            "enum": [
              "REDISTRIBUTE_TRANSLATIONS",
              "ANGULAR_CONTROL",
              "VERTICAL_REVIEW",
              "STAGE_REVIEW"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Objectives",
          "type": "array"
        },
        "source_convention": {
          "default": "UNSPECIFIED",
          "enum": [
            "UNSPECIFIED",
            "SOURCE_LABELS_AS_RECORDED"
          ],
          "title": "Source Convention",
          "type": "string"
        },
        "illustration": {
          "default": "NONE",
          "enum": [
            "NONE",
            "HALF_MAGNITUDE"
          ],
          "title": "Illustration",
          "type": "string"
        },
        "illustration_measurement_ref": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Illustration Measurement Ref"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/MovementTarget"
          },
          "maxItems": 64,
          "title": "Targets",
          "type": "array"
        },
        "attachment_options": {
          "items": {
            "$ref": "#/$defs/AttachmentOption"
          },
          "maxItems": 6,
          "title": "Attachment Options",
          "type": "array"
        },
        "catalog_policy": {
          "default": "CONCEPTS_WITH_SUPPLIED_SPECS",
          "enum": [
            "CONCEPTS_WITH_SUPPLIED_SPECS",
            "SUPPLIED_OPTIONS_ONLY"
          ],
          "title": "Catalog Policy",
          "type": "string"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/Phase"
          },
          "maxItems": 16,
          "title": "Phases",
          "type": "array"
        },
        "stage_value_basis": {
          "default": "UNSPECIFIED",
          "enum": [
            "UNSPECIFIED",
            "INCREMENTS_MATCH_SOURCE_LABELS"
          ],
          "title": "Stage Value Basis",
          "type": "string"
        },
        "support_constraints": {
          "items": {
            "$ref": "#/$defs/SupportConstraint"
          },
          "maxItems": 16,
          "title": "Support Constraints",
          "type": "array"
        }
      },
      "title": "PlanningOptions",
      "type": "object"
    },
    "ReviewDetails": {
      "additionalProperties": false,
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/AttachmentDetail"
          },
          "maxItems": 32,
          "title": "Attachments",
          "type": "array"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/SuppliedStage"
          },
          "maxItems": 64,
          "title": "Stages",
          "type": "array"
        },
        "allocations": {
          "items": {
            "$ref": "#/$defs/SuppliedAllocation"
          },
          "maxItems": 128,
          "title": "Allocations",
          "type": "array"
        },
        "anchorage_notes": {
          "items": {
            "$ref": "#/$defs/AnchorageNote"
          },
          "maxItems": 32,
          "title": "Anchorage Notes",
          "type": "array"
        }
      },
      "title": "ReviewDetails",
      "type": "object"
    },
    "SourceContext": {
      "additionalProperties": false,
      "description": "All supplied metadata are unverified claims, including notation.",
      "properties": {
        "source_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        },
        "notation": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "FDI",
            "UNIVERSAL",
            "PALMER"
          ],
          "title": "Notation",
          "type": "string"
        },
        "dentition": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "PERMANENT",
            "PRIMARY",
            "MIXED"
          ],
          "title": "Dentition",
          "type": "string"
        },
        "arch": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "UPPER",
            "LOWER",
            "BOTH"
          ],
          "title": "Arch",
          "type": "string"
        },
        "plan_mode": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "ALIGN_FINAL",
            "DOCTOR_FINAL",
            "COMPARISON"
          ],
          "title": "Plan Mode",
          "type": "string"
        },
        "reference_basis": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "CROWN_CENTER",
            "VIRTUAL_ROOT_APEX",
            "CUSP_TIP"
          ],
          "title": "Reference Basis",
          "type": "string"
        },
        "scope": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "TOTAL",
            "CUMULATIVE",
            "INCREMENTAL"
          ],
          "title": "Scope",
          "type": "string"
        },
        "stage_index": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage Index"
        },
        "coordinate_frame": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coordinate Frame"
        },
        "case_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "plan_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Id"
        },
        "decimal_separator": {
          "default": "DOT",
          "enum": [
            "DOT",
            "COMMA"
          ],
          "title": "Decimal Separator",
          "type": "string"
        }
      },
      "title": "SourceContext",
      "type": "object"
    },
    "SuppliedAllocation": {
      "additionalProperties": false,
      "properties": {
        "stage_id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Stage Id",
          "type": "string"
        },
        "tooth_ref": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Tooth Ref",
          "type": "string"
        },
        "measurement_ref": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Measurement Ref",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "maxLength": 24,
              "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "mm",
                "deg"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "stage_id",
        "tooth_ref",
        "measurement_ref"
      ],
      "title": "SuppliedAllocation",
      "type": "object"
    },
    "SuppliedStage": {
      "additionalProperties": false,
      "properties": {
        "stage_id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Stage Id",
          "type": "string"
        },
        "order": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "duration_days": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Days"
        }
      },
      "required": [
        "stage_id",
        "order"
      ],
      "title": "SuppliedStage",
      "type": "object"
    },
    "SupportConstraint": {
      "additionalProperties": false,
      "properties": {
        "phase_id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Phase Id",
          "type": "string"
        },
        "support_tooth_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Support Tooth Refs",
          "type": "array"
        },
        "active_tooth_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Active Tooth Refs",
          "type": "array"
        },
        "assumption": {
          "const": "STATIONARY_IN_FICTIONAL_SCENARIO",
          "title": "Assumption",
          "type": "string"
        }
      },
      "required": [
        "phase_id",
        "support_tooth_refs",
        "active_tooth_refs",
        "assumption"
      ],
      "title": "SupportConstraint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "raw_text": {
      "maxLength": 100000,
      "title": "Raw Text",
      "type": "string"
    },
    "source_claim": {
      "default": "Unknown",
      "enum": [
        "Unknown",
        "ClinCheck",
        "SureSmile"
      ],
      "title": "Source Claim",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/SourceContext"
    },
    "synthetic_data_confirmed": {
      "title": "Synthetic Data Confirmed",
      "type": "boolean"
    },
    "requested_assessments": {
      "items": {
        "enum": [
          "SUITABILITY",
          "PERIODONTAL",
          "ROOT_BONE",
          "OCCLUSION",
          "IPR",
          "EXTRACTION_SURGERY",
          "PROGNOSIS",
          "ATTACHMENTS",
          "COLLISIONS",
          "COMPLEX_INTERVENTION"
        ],
        "type": "string"
      },
      "maxItems": 10,
      "title": "Requested Assessments",
      "type": "array"
    },
    "recovery_receipt": {
      "anyOf": [
        {
          "maxLength": 100000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recovery Receipt"
    },
    "module": {
      "default": "macro",
      "enum": [
        "macro",
        "micro",
        "nano"
      ],
      "title": "Module",
      "type": "string"
    },
    "raw_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Sha256",
      "type": "string"
    },
    "review_details": {
      "$ref": "#/$defs/ReviewDetails"
    },
    "planning_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/FunctionalContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "planning_options": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanningOptions"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "raw_text",
    "synthetic_data_confirmed",
    "raw_sha256"
  ],
  "title": "InteractiveSubmission",
  "type": "object"
}
