{
  "$defs": {
    "AnchorageNote": {
      "additionalProperties": false,
      "properties": {
        "tooth_ref": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tooth Ref"
        },
        "note": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "note"
      ],
      "title": "AnchorageNote",
      "type": "object"
    },
    "AttachmentDetail": {
      "additionalProperties": false,
      "properties": {
        "tooth_ref": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Tooth Ref",
          "type": "string"
        },
        "choice": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "ATTACHMENT",
            "NO_ATTACHMENT"
          ],
          "title": "Choice",
          "type": "string"
        },
        "design": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Design"
        },
        "width_mm": {
          "anyOf": [
            {
              "maxLength": 24,
              "pattern": "^\\+?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width Mm"
        },
        "height_mm": {
          "anyOf": [
            {
              "maxLength": 24,
              "pattern": "^\\+?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height Mm"
        },
        "depth_mm": {
          "anyOf": [
            {
              "maxLength": 24,
              "pattern": "^\\+?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth Mm"
        },
        "surface": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Surface"
        },
        "orientation": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orientation"
        }
      },
      "required": [
        "tooth_ref"
      ],
      "title": "AttachmentDetail",
      "type": "object"
    },
    "ReviewDetails": {
      "additionalProperties": false,
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/AttachmentDetail"
          },
          "maxItems": 32,
          "title": "Attachments",
          "type": "array"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/SuppliedStage"
          },
          "maxItems": 64,
          "title": "Stages",
          "type": "array"
        },
        "allocations": {
          "items": {
            "$ref": "#/$defs/SuppliedAllocation"
          },
          "maxItems": 128,
          "title": "Allocations",
          "type": "array"
        },
        "anchorage_notes": {
          "items": {
            "$ref": "#/$defs/AnchorageNote"
          },
          "maxItems": 32,
          "title": "Anchorage Notes",
          "type": "array"
        }
      },
      "title": "ReviewDetails",
      "type": "object"
    },
    "SourceContext": {
      "additionalProperties": false,
      "description": "All supplied metadata are unverified claims, including notation.",
      "properties": {
        "source_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        },
        "notation": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "FDI",
            "UNIVERSAL",
            "PALMER"
          ],
          "title": "Notation",
          "type": "string"
        },
        "dentition": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "PERMANENT",
            "PRIMARY",
            "MIXED"
          ],
          "title": "Dentition",
          "type": "string"
        },
        "arch": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "UPPER",
            "LOWER",
            "BOTH"
          ],
          "title": "Arch",
          "type": "string"
        },
        "plan_mode": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "ALIGN_FINAL",
            "DOCTOR_FINAL",
            "COMPARISON"
          ],
          "title": "Plan Mode",
          "type": "string"
        },
        "reference_basis": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "CROWN_CENTER",
            "VIRTUAL_ROOT_APEX",
            "CUSP_TIP"
          ],
          "title": "Reference Basis",
          "type": "string"
        },
        "scope": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "TOTAL",
            "CUMULATIVE",
            "INCREMENTAL"
          ],
          "title": "Scope",
          "type": "string"
        },
        "stage_index": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage Index"
        },
        "coordinate_frame": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coordinate Frame"
        },
        "case_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "plan_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Id"
        },
        "decimal_separator": {
          "default": "DOT",
          "enum": [
            "DOT",
            "COMMA"
          ],
          "title": "Decimal Separator",
          "type": "string"
        }
      },
      "title": "SourceContext",
      "type": "object"
    },
    "SuppliedAllocation": {
      "additionalProperties": false,
      "properties": {
        "stage_id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Stage Id",
          "type": "string"
        },
        "tooth_ref": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Tooth Ref",
          "type": "string"
        },
        "measurement_ref": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Measurement Ref",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "maxLength": 24,
              "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "mm",
                "deg"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "stage_id",
        "tooth_ref",
        "measurement_ref"
      ],
      "title": "SuppliedAllocation",
      "type": "object"
    },
    "SuppliedStage": {
      "additionalProperties": false,
      "properties": {
        "stage_id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Stage Id",
          "type": "string"
        },
        "order": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "duration_days": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Days"
        }
      },
      "required": [
        "stage_id",
        "order"
      ],
      "title": "SuppliedStage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "raw_text": {
      "maxLength": 100000,
      "title": "Raw Text",
      "type": "string"
    },
    "source_claim": {
      "default": "Unknown",
      "enum": [
        "Unknown",
        "ClinCheck",
        "SureSmile"
      ],
      "title": "Source Claim",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/SourceContext"
    },
    "synthetic_data_confirmed": {
      "title": "Synthetic Data Confirmed",
      "type": "boolean"
    },
    "requested_assessments": {
      "items": {
        "enum": [
          "SUITABILITY",
          "PERIODONTAL",
          "ROOT_BONE",
          "OCCLUSION",
          "IPR",
          "EXTRACTION_SURGERY",
          "PROGNOSIS",
          "ATTACHMENTS",
          "COLLISIONS",
          "COMPLEX_INTERVENTION"
        ],
        "type": "string"
      },
      "maxItems": 10,
      "title": "Requested Assessments",
      "type": "array"
    },
    "recovery_receipt": {
      "anyOf": [
        {
          "maxLength": 100000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recovery Receipt"
    },
    "module": {
      "default": "macro",
      "enum": [
        "macro",
        "micro",
        "nano"
      ],
      "title": "Module",
      "type": "string"
    },
    "raw_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Sha256",
      "type": "string"
    },
    "review_details": {
      "$ref": "#/$defs/ReviewDetails"
    }
  },
  "required": [
    "raw_text",
    "synthetic_data_confirmed",
    "raw_sha256"
  ],
  "title": "InteractiveSubmission",
  "type": "object"
}
