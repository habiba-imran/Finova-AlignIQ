{
  "$defs": {
    "AdapterInfo": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "verified": {
          "const": false,
          "default": false,
          "title": "Verified",
          "type": "boolean"
        },
        "verified_source_versions": {
          "items": {
            "type": "string"
          },
          "title": "Verified Source Versions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "AdapterInfo",
      "type": "object"
    },
    "AxisCoverage": {
      "additionalProperties": false,
      "description": "Declared positions only; no expected clinical axes are invented.",
      "properties": {
        "expected_axes": {
          "default": null,
          "title": "Expected Axes",
          "type": "null"
        },
        "declared_measurements": {
          "default": 0,
          "title": "Declared Measurements",
          "type": "integer"
        },
        "numeric_present": {
          "default": 0,
          "title": "Numeric Present",
          "type": "integer"
        },
        "explicit_zero": {
          "default": 0,
          "title": "Explicit Zero",
          "type": "integer"
        },
        "missing": {
          "default": 0,
          "title": "Missing",
          "type": "integer"
        },
        "invalid": {
          "default": 0,
          "title": "Invalid",
          "type": "integer"
        },
        "ambiguous": {
          "default": 0,
          "title": "Ambiguous",
          "type": "integer"
        },
        "unsupported": {
          "default": 0,
          "title": "Unsupported",
          "type": "integer"
        },
        "unverified": {
          "default": 0,
          "title": "Unverified",
          "type": "integer"
        }
      },
      "title": "AxisCoverage",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "fixture_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Fixture Id",
          "type": "string"
        },
        "release_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Release Digest",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "expected_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Sha256",
          "type": "string"
        },
        "source_evidence_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Evidence Sha256"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "fixture_id",
        "release_digest",
        "raw_sha256",
        "expected_sha256",
        "source_evidence_sha256",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Rule Version",
          "type": "string"
        },
        "triggering_rules": {
          "items": {
            "$ref": "#/$defs/RuleRef"
          },
          "title": "Triggering Rules",
          "type": "array"
        },
        "tooth_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tooth Id"
        },
        "status": {
          "enum": [
            "OBSERVED",
            "SEMANTICS_UNKNOWN",
            "CONTEXT_REQUIRED",
            "DISABLED",
            "SUPPRESSED",
            "NOT_APPLICABLE",
            "PARSE_INVALID"
          ],
          "title": "Status",
          "type": "string"
        },
        "applicable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Applicable"
        },
        "evaluated": {
          "title": "Evaluated",
          "type": "boolean"
        },
        "finding_type": {
          "enum": [
            "TECHNICAL",
            "DESCRIPTIVE",
            "SAFETY",
            "UNAVAILABLE",
            "OUTPUT"
          ],
          "title": "Finding Type",
          "type": "string"
        },
        "template_id": {
          "title": "Template Id",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "observed_measurements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObservedMeasurement"
          },
          "title": "Observed Measurements",
          "type": "array"
        },
        "missing_required_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing Required Fields",
          "type": "array"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "abstain_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abstain Reason"
        },
        "review_status": {
          "const": "DRAFT",
          "default": "DRAFT",
          "title": "Review Status",
          "type": "string"
        },
        "conflict_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conflict Group"
        },
        "summary_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Summary Counts",
          "type": "object"
        }
      },
      "required": [
        "finding_id",
        "rule_id",
        "triggering_rules",
        "status",
        "applicable",
        "evaluated",
        "finding_type",
        "template_id",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "ObservedMeasurement": {
      "additionalProperties": false,
      "properties": {
        "measurement_id": {
          "title": "Measurement Id",
          "type": "string"
        },
        "tooth_ref": {
          "title": "Tooth Ref",
          "type": "string"
        },
        "raw_tooth_identifier": {
          "title": "Raw Tooth Identifier",
          "type": "string"
        },
        "raw_label": {
          "title": "Raw Label",
          "type": "string"
        },
        "raw_value": {
          "title": "Raw Value",
          "type": "string"
        },
        "raw_number": {
          "title": "Raw Number",
          "type": "string"
        },
        "raw_sign": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Sign"
        },
        "raw_direction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Direction"
        },
        "signed_decimal": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Signed Decimal",
          "type": "string"
        },
        "magnitude": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Magnitude",
          "type": "string"
        },
        "verification": {
          "enum": [
            "VERIFIED",
            "TEST_ONLY"
          ],
          "title": "Verification",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/SemanticComponent"
          },
          "title": "Components",
          "type": "array"
        },
        "input_refs": {
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "source_spans": {
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "title": "Source Spans",
          "type": "array"
        }
      },
      "required": [
        "measurement_id",
        "tooth_ref",
        "raw_tooth_identifier",
        "raw_label",
        "raw_value",
        "raw_number",
        "raw_sign",
        "raw_direction",
        "signed_decimal",
        "magnitude",
        "verification",
        "components",
        "input_refs",
        "source_spans"
      ],
      "title": "ObservedMeasurement",
      "type": "object"
    },
    "RawCell": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "title": "Raw",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        }
      },
      "required": [
        "raw",
        "span"
      ],
      "title": "RawCell",
      "type": "object"
    },
    "ReviewCoverage": {
      "additionalProperties": false,
      "properties": {
        "declared_positions": {
          "title": "Declared Positions",
          "type": "integer"
        },
        "eligible_positions": {
          "title": "Eligible Positions",
          "type": "integer"
        },
        "unavailable_positions": {
          "title": "Unavailable Positions",
          "type": "integer"
        },
        "eligible_explicit_zero": {
          "title": "Eligible Explicit Zero",
          "type": "integer"
        },
        "eligible_nonzero": {
          "title": "Eligible Nonzero",
          "type": "integer"
        },
        "expected_axes": {
          "default": null,
          "title": "Expected Axes",
          "type": "null"
        },
        "lexical": {
          "$ref": "#/$defs/AxisCoverage"
        }
      },
      "required": [
        "declared_positions",
        "eligible_positions",
        "unavailable_positions",
        "eligible_explicit_zero",
        "eligible_nonzero",
        "lexical"
      ],
      "title": "ReviewCoverage",
      "type": "object"
    },
    "RuleEvaluation": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "OBSERVED",
            "SEMANTICS_UNKNOWN",
            "CONTEXT_REQUIRED",
            "DISABLED",
            "SUPPRESSED",
            "NOT_APPLICABLE",
            "PARSE_INVALID"
          ],
          "title": "Status",
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "missing_required_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing Required Fields",
          "type": "array"
        },
        "abstain_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abstain Reason"
        }
      },
      "required": [
        "rule_id",
        "status",
        "finding_ids"
      ],
      "title": "RuleEvaluation",
      "type": "object"
    },
    "RuleRef": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "rule_id"
      ],
      "title": "RuleRef",
      "type": "object"
    },
    "SemanticComponent": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "source_application",
            "source_version",
            "tooth_identifier",
            "notation",
            "dentition",
            "arch",
            "axis",
            "unit",
            "sign",
            "direction",
            "plan_mode",
            "reference_basis",
            "scope",
            "stage_index",
            "stage_kind",
            "coordinate_frame",
            "comparison_left_plan",
            "comparison_right_plan",
            "comparison_operation"
          ],
          "title": "Name",
          "type": "string"
        },
        "status": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "CONFLICT",
            "INVALID",
            "VERIFIED",
            "TEST_ONLY"
          ],
          "title": "Status",
          "type": "string"
        },
        "claim_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Value"
        },
        "canonical_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Value"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "abstain_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Abstain Reasons",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "source_spans": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "title": "Source Spans",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "SemanticComponent",
      "type": "object"
    },
    "SourceContext": {
      "additionalProperties": false,
      "description": "All supplied metadata are unverified claims, including notation.",
      "properties": {
        "source_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        },
        "notation": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "FDI",
            "UNIVERSAL",
            "PALMER"
          ],
          "title": "Notation",
          "type": "string"
        },
        "dentition": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "PERMANENT",
            "PRIMARY",
            "MIXED"
          ],
          "title": "Dentition",
          "type": "string"
        },
        "arch": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "UPPER",
            "LOWER",
            "BOTH"
          ],
          "title": "Arch",
          "type": "string"
        },
        "plan_mode": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "ALIGN_FINAL",
            "DOCTOR_FINAL",
            "COMPARISON"
          ],
          "title": "Plan Mode",
          "type": "string"
        },
        "reference_basis": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "CROWN_CENTER",
            "VIRTUAL_ROOT_APEX",
            "CUSP_TIP"
          ],
          "title": "Reference Basis",
          "type": "string"
        },
        "scope": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "TOTAL",
            "CUMULATIVE",
            "INCREMENTAL"
          ],
          "title": "Scope",
          "type": "string"
        },
        "stage_index": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage Index"
        },
        "coordinate_frame": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coordinate Frame"
        },
        "case_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "plan_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Id"
        },
        "decimal_separator": {
          "default": "DOT",
          "enum": [
            "DOT",
            "COMMA"
          ],
          "title": "Decimal Separator",
          "type": "string"
        }
      },
      "title": "SourceContext",
      "type": "object"
    },
    "SourceInfo": {
      "additionalProperties": false,
      "properties": {
        "source_claim": {
          "enum": [
            "Unknown",
            "ClinCheck",
            "SureSmile"
          ],
          "title": "Source Claim",
          "type": "string"
        },
        "detected_claims": {
          "items": {
            "enum": [
              "Unknown",
              "ClinCheck",
              "SureSmile"
            ],
            "type": "string"
          },
          "title": "Detected Claims",
          "type": "array"
        },
        "claim_evidence": {
          "items": {
            "$ref": "#/$defs/RawCell"
          },
          "title": "Claim Evidence",
          "type": "array"
        },
        "verification_status": {
          "const": "UNVERIFIED",
          "default": "UNVERIFIED",
          "title": "Verification Status",
          "type": "string"
        },
        "adapter": {
          "$ref": "#/$defs/AdapterInfo"
        },
        "candidate_adapter": {
          "anyOf": [
            {
              "$ref": "#/$defs/AdapterInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "context": {
          "$ref": "#/$defs/SourceContext"
        },
        "metadata_status": {
          "const": "USER_CLAIMS_UNVERIFIED",
          "default": "USER_CLAIMS_UNVERIFIED",
          "title": "Metadata Status",
          "type": "string"
        }
      },
      "required": [
        "source_claim",
        "adapter",
        "context"
      ],
      "title": "SourceInfo",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "description": "Offsets: zero-based Unicode code points, end exclusive. Line/columns: one-based.",
      "properties": {
        "line": {
          "title": "Line",
          "type": "integer"
        },
        "column_start": {
          "title": "Column Start",
          "type": "integer"
        },
        "column_end": {
          "title": "Column End",
          "type": "integer"
        },
        "start": {
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "title": "End",
          "type": "integer"
        },
        "cell_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Index"
        }
      },
      "required": [
        "line",
        "column_start",
        "column_end",
        "start",
        "end"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "engine_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Engine Version",
      "type": "string"
    },
    "rule_set_version": {
      "const": "2.0.0-phase2a",
      "default": "2.0.0-phase2a",
      "title": "Rule Set Version",
      "type": "string"
    },
    "report_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Id",
      "type": "string"
    },
    "review_status": {
      "const": "DRAFT",
      "default": "DRAFT",
      "title": "Review Status",
      "type": "string"
    },
    "intended_for": {
      "const": "CLINICIAN_REVIEW",
      "default": "CLINICIAN_REVIEW",
      "title": "Intended For",
      "type": "string"
    },
    "notice": {
      "const": "Prototype — not for clinical use. DRAFT for clinician review. Descriptions concern programmed values, never achieved movement.",
      "default": "Prototype — not for clinical use. DRAFT for clinician review. Descriptions concern programmed values, never achieved movement.",
      "title": "Notice",
      "type": "string"
    },
    "evidence_domain": {
      "enum": [
        "UNVERIFIED",
        "AUTHORIZED_VENDOR",
        "TEST_ONLY"
      ],
      "title": "Evidence Domain",
      "type": "string"
    },
    "clinical_analysis_enabled": {
      "const": false,
      "default": false,
      "title": "Clinical Analysis Enabled",
      "type": "boolean"
    },
    "raw_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Sha256",
      "type": "string"
    },
    "parser_version": {
      "title": "Parser Version",
      "type": "string"
    },
    "normalization_version": {
      "title": "Normalization Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceInfo"
    },
    "coverage": {
      "$ref": "#/$defs/ReviewCoverage"
    },
    "requested_assessments": {
      "items": {
        "enum": [
          "SUITABILITY",
          "PERIODONTAL",
          "ROOT_BONE",
          "OCCLUSION",
          "IPR",
          "EXTRACTION_SURGERY",
          "PROGNOSIS",
          "ATTACHMENTS",
          "COLLISIONS",
          "COMPLEX_INTERVENTION"
        ],
        "type": "string"
      },
      "title": "Requested Assessments",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "evaluations": {
      "items": {
        "$ref": "#/$defs/RuleEvaluation"
      },
      "title": "Evaluations",
      "type": "array"
