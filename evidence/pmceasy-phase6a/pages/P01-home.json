{
  "title": "PMCEASY | The A.I. Companion",
  "headings": [
    {
      "level": "H1",
      "text": "THE EASY WAY TO PLAN\nYOUR ALIGNER CASES WITH A.I."
    },
    {
      "level": "H3",
      "text": "EXPAND YOUR COMFORT ZONE WITH\nTHE REAL-TIME \nA.I. COMPANION"
    },
    {
      "level": "H2",
      "text": "A.I. Planning Assistant"
    },
    {
      "level": "H3",
      "text": "1. Copy the Tooth Mov. Table"
    },
    {
      "level": "H3",
      "text": "2. Paste and run the table"
    },
    {
      "level": "H3",
      "text": "3. Send the A.I. aided comments to the CAD designer"
    },
    {
      "level": "H3",
      "text": "NOW SUPPORTS FUNCTIONAL TREATMENTS"
    },
    {
      "level": "H2",
      "text": "A.I. Attachment Interface"
    },
    {
      "level": "H3",
      "text": "1. Copy the Tooth Mov. Table"
    },
    {
      "level": "H3",
      "text": "2. Paste and run the table"
    },
    {
      "level": "H3",
      "text": "3. Place the suggested attachments on your plan"
    },
    {
      "level": "H2",
      "text": "A.I. Sequencer"
    },
    {
      "level": "H3",
      "text": "1. Copy the Tooth Mov. Table"
    },
    {
      "level": "H3",
      "text": "2. Paste and run the table"
    },
    {
      "level": "H3",
      "text": "3. Verify / Modify the plan according to the A.I. aided staging and make a note of the anchorage suggestions"
    }
  ],
