# Backend-only settings. Standard Templates and deterministic parsing need no credentials.
# This template is not automatically loaded. scripts/run_dev.py --env-file is explicit.
# Set these in the BACKEND PowerShell terminal or your approved secret manager.
# Never prefix the secret with VITE_ or put it in frontend files.
GROQ_API_KEY=
FINOVA_GROQ_SYNTHETIC_ENABLED=false
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0
GROQ_MAX_COMPLETION_TOKENS=2048
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT_SECONDS=6
GROQ_MAX_RETRIES=0
GROQ_MAX_RETRY_DELAY_SECONDS=1
GROQ_MAX_WORDING_FINDINGS=16

# Independent parser service: never substitutes for GROQ_API_KEY.
GROQ_API_KEY_2=
FINOVA_ENVIRONMENT=production
FINOVA_PARSER_GROQ_ENABLED=false
GROQ_PARSER_MODEL=openai/gpt-oss-120b
GROQ_PARSER_TIMEOUT_SECONDS=8
GROQ_PARSER_MAX_COMPLETION_TOKENS=2048
GROQ_PARSER_REASONING_EFFORT=low

# Parsing requires development + flag + key + exact bundled synthetic text + per-action consent.
# The optional explicit live-probe CLI uses only its own fixed synthetic payloads.

# No environment variable enables real-patient transmission or vendor mappings.
# Comment wording requires eligible TEST_ONLY evidence and explicit synthetic permission.
# Vite proxies /api to loopback; it never talks directly to Groq.
